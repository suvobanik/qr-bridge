{
  "name": "qr-print-bridge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "guest",
    "vendor-desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace vendor-desktop",
    "build": "npm run build --workspace guest",
    "build:guest": "npm run build --workspace guest",
    "build:desktop": "npm run build --workspace vendor-desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start --workspace vendor-desktop",
    "package": "npm run package --workspace vendor-desktop"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^18.0.7"
  }
}
